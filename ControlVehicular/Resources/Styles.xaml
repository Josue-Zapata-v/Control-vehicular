<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Primario" Color="#1E5AA8"/>
    <SolidColorBrush x:Key="PrimarioOscuro" Color="#15437E"/>
    <SolidColorBrush x:Key="Fondo" Color="#F4F7FB"/>
    <SolidColorBrush x:Key="Superficie" Color="White"/>
    <SolidColorBrush x:Key="Borde" Color="#D6DFEB"/>
    <SolidColorBrush x:Key="Texto" Color="#1D2939"/>
    <!-- El texto hereda el color del control que lo contiene: blanco en botones y encabezados azules. -->
    <Style TargetType="Window"><Setter Property="Foreground" Value="{StaticResource Texto}"/></Style>
    <Style TargetType="Label"><Setter Property="Foreground" Value="#475467"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="0,3"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="BorderBrush" Value="{StaticResource Borde}"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,5"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
    <Style TargetType="DatePicker"><Setter Property="Margin" Value="0,0,0,8"/></Style>
    <Style TargetType="Button"><Setter Property="Background" Value="{StaticResource Primario}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="13,8"/><Setter Property="Margin" Value="0,4"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="RowHeight" Value="31"/><Setter Property="AlternatingRowBackground" Value="#F8FAFC"/></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{StaticResource Primario}"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="8"/></Style>
</ResourceDictionary>
